{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentimentAnalysisResponse",
  "description": "Output schema for the Sentiment Analysis Assistant",
  "type": "object",
  "required": ["request_id", "label", "confidence", "latency_ms", "status"],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID echoed from the request"
    },
    "label": {
      "type": "string",
      "enum": ["positive", "negative", "neutral", "uncertain"],
      "description": "Predicted sentiment label"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Model confidence score — must be < 0.55 when label is uncertain"
    },
    "key_phrase": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "The phrase in the input that most influenced the classification"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "End-to-end response time in milliseconds"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "fallback", "timeout", "error"],
      "description": "Processing status"
    },
    "error_code": {
      "type": ["string", "null"],
      "enum": [
        "PII_DETECTED",
        "UNSAFE_INPUT",
        "EMPTY_INPUT",
        "INPUT_TOO_LONG",
        "MODEL_ERROR",
        null
      ],
      "description": "Null on success; structured error identifier on failure"
    },
    "requires_human_review": {
      "type": "boolean",
      "description": "True when confidence < 0.55 or error_code is set"
    },
    "model_version": {
      "type": "string",
      "description": "Version string of the model that produced this response"
    }
  },
  "if": {
    "properties": { "label": { "const": "uncertain" } }
  },
  "then": {
    "properties": { "confidence": { "maximum": 0.55 } }
  }
}
